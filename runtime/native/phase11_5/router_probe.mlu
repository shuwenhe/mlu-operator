#include <bang.h>
#include <cnrt.h>
#include <stdint.h>

__mlu_global__ void probe(const bfloat16_t *input, const bfloat16_t *weights,
    float *outputs, float *products, float *partials, int rows, int mode) {
    constexpr int width = 2048;
    const bool mixed = mode == 6;
    const int lanes = mixed || mode == 5 ? 4 : mode;
    __nram__ bfloat16_t x[width], w[width];
    __nram__ float xf[width], wf[width], product[width];
    for (int dot = taskId; dot < rows * 64; dot += taskDim) {
        __memcpy(x, input + dot / 64 * width, sizeof(x), GDRAM2NRAM);
        __memcpy(w, weights + dot % 64 * width, sizeof(w), GDRAM2NRAM);
        __bang_bfloat162float(xf, x, width);
        __bang_bfloat162float(wf, w, width);
        __bang_mul(product, xf, wf, width);
        __memcpy(products + dot * width, product, sizeof(product), NRAM2GDRAM);
        __nram__ float sums[64];
        if (mixed && dot / 64 < rows / 4 * 4) {
            constexpr int panel = 112, full_panels = width / panel;
            for (int block = 0; block <= full_panels; ++block) {
                const int start = block * panel;
                const int end = block == full_panels ? width : start + panel;
                float sum = 0.0f;
                for (int k = start; k < end; ++k) sum += product[k];
                sums[block] = sum;
            }
            __memcpy(partials + dot * 19, sums, 19 * sizeof(float), NRAM2GDRAM);
            float result = sums[full_panels];
            for (int block = 0; block < full_panels; ++block) result += sums[block];
            outputs[dot] = result;
            continue;
        }
        for (int lane = 0; lane < lanes; ++lane) sums[lane] = 0.0f;
        int start = 0;
        if (mode == 5 || mixed) {
            for (; start < 4; ++start) sums[0] += product[start];
        }
        for (int k = start; k < width; ++k) sums[k % lanes] += product[k];
        if (mixed) {
            for (int lane = 4; lane < 19; ++lane) sums[lane] = 0.0f;
            __memcpy(partials + dot * 19, sums, 19 * sizeof(float), NRAM2GDRAM);
        } else {
            __memcpy(partials + dot * lanes, sums, lanes * sizeof(float), NRAM2GDRAM);
        }
        for (int step = lanes / 2; step > 0; step /= 2)
            for (int lane = 0; lane < step; ++lane) sums[lane] += sums[lane + step];
        outputs[dot] = sums[0];
    }
}

extern "C" cnrtRet_t phase115_router_probe(cnrtQueue_t queue, const bfloat16_t *x,
    const bfloat16_t *w, float *out, float *products, float *partials, int rows, int lanes) {
    if (rows <= 0 || rows > 17 || (lanes != 1 && lanes != 4 && lanes != 5 && lanes != 6 && lanes != 64))
        return cnrtErrorArgsInvalid;
    const cnrtDim3_t grid = {32, 1, 1};
    probe<<<grid, cnrtFuncTypeBlock, queue>>>(x, w, out, products, partials, rows, lanes);
    return cnrtGetLastError();
}
