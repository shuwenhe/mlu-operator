// Phase 8 BF16 lane recurrence and fold, continued over rank-local K ranges.
#include <bang.h>
#include "matrix_gemm.h"
#include "packed_weight.h"

using Low = bfloat16_t;

namespace {
constexpr int lanes = 64;
constexpr int n_tile = matrix_n;
constexpr int k_tile = matrix_k;

__mlu_global__ void ordered_gemm(const Low *a, const Low *packed, float *state,
                                        float *c, int m, int n, int k, bool first, bool last) {
    __nram__ Low weight_rows[n_tile * k_tile], weight_columns[n_tile * k_tile], input[k_tile];
    __nram__ float weights[n_tile * k_tile], activation[k_tile], accum[lanes * n_tile];
    __nram__ float temp[n_tile], folded[n_tile];
    const int quant_n = (n + n_tile - 1) / n_tile;
    const int quant_k = (k + k_tile - 1) / k_tile;
    for (int task = taskId; task < m * quant_n; task += taskDim) {
        const int row = task / quant_n, col_tile = task % quant_n;
        float *tile_state = state + size_t(task) * lanes * n_tile;
        if (first)
            __bang_write_value(accum, lanes * n_tile, 0.f);
        else
            __memcpy(accum, tile_state, sizeof(accum), GDRAM2NRAM);
        for (int block = 0; block < quant_k; ++block) {
            const int start = block * k_tile;
            const int width = k - start < k_tile ? k - start : k_tile;
            __memcpy(input, a + size_t(row) * k + start, width * sizeof(Low), GDRAM2NRAM);
            __bang_bfloat162float(activation, input, width);
            __memcpy(weight_rows, packed + (size_t(col_tile) * quant_k + block) * n_tile * k_tile,
                     sizeof(weight_rows), GDRAM2NRAM);
            __bang_transpose(weight_columns, weight_rows, n_tile, k_tile);
            __bang_bfloat162float(weights, weight_columns, n_tile * k_tile);
            for (int p = 0; p < width; ++p) {
                float *lane = accum + (p % lanes) * n_tile;
                __bang_mul_scalar(temp, weights + p * n_tile, activation[p], n_tile);
                __bang_add(lane, lane, temp, n_tile);
            }
        }
        if (!last) {
            __memcpy(tile_state, accum, sizeof(accum), NRAM2GDRAM);
            continue;
        }
        for (int lane = 0; lane < 8; ++lane) {
            float *base = accum + lane * n_tile;
            float *a1 = base + 8 * n_tile;
            float *a2 = base + 16 * n_tile;
            float *a3 = base + 24 * n_tile;
            __bang_add(base, base, base + 32 * n_tile, n_tile);
            __bang_add(a2, a2, base + 48 * n_tile, n_tile);
            __bang_add(a3, a3, base + 56 * n_tile, n_tile);
            __bang_add(a1, a1, base + 40 * n_tile, n_tile);
            __bang_add(base, base, a2, n_tile);
            __bang_add(a3, a3, a1, n_tile);
            __bang_add(base, base, a3, n_tile);
        }
        for (int lane = 0; lane < 4; ++lane)
            __bang_add(accum + lane * n_tile, accum + lane * n_tile,
                       accum + (lane + 4) * n_tile, n_tile);
        __bang_add(accum, accum, accum + 2 * n_tile, n_tile);
        __bang_add(accum + n_tile, accum + n_tile, accum + 3 * n_tile, n_tile);
        __bang_add(temp, accum, accum + n_tile, n_tile);
        const int start = col_tile * n_tile;
        const int width = n - start < n_tile ? n - start : n_tile;
        for (int col = 0; col < width; ++col) folded[col] = temp[matrix_rhs_slot(0, col) / k_tile];
        __memcpy(c + size_t(row) * n + start, folded, width * sizeof(float), NRAM2GDRAM);
    }
}
}

extern "C" cnrtRet_t phase1333_continue(
    cnrtQueue_t queue, const uint16_t *x, const mlu::PackedWeight *packed,
    float *state, float *out, int rows, bool first, bool last) {
    if (!queue || !x || !packed || !state || !out || rows <= 0 || rows > 128 ||
        packed->type() != mlu::WeightType::bf16 || packed->n() != 2048 ||
        packed->k() <= 0 || packed->k() > 2048 || packed->k() % matrix_k)
        return cnrtErrorArgsInvalid;
    ordered_gemm<<<(cnrtDim3_t{32, 1, 1}), cnrtFuncTypeBlock, queue>>>(
        reinterpret_cast<const Low *>(x), reinterpret_cast<const Low *>(packed->data()),
        state, out, rows, packed->n(), packed->k(), first, last);
    return cnrtGetLastError();
}
